{
  "salon": {
    "provider": "altegio",
    "partner_token": "env:ALTEGIO_PARTNER_TOKEN",
    "location_id": 123456,
    "staff_id": 0,
    "country_code": "38",
    "services": {
      "Женская стрижка": 331,
      "Мужская стрижка": 332,
      "Окрашивание в один тон": 333,
      "Мелирование": 334,
      "Маникюр с покрытием": 335,
      "Укладка": 336
    }
  },
  "auto": {
    "provider": "generic",
    "title": "CleverBox",
    "base_url": "https://ПОДСТАВЬТЕ-АДРЕС-API-ИЗ-ДОКУМЕНТАЦИИ",
    "headers": {"Authorization": "Bearer env:CLEVERBOX_TOKEN"},
    "staff_id": "1",
    "services": {
      "Компьютерная диагностика": "10",
      "Замена масла и фильтра (работа)": "11"
    },
    "slots": {
      "method": "GET",
      "path": "/slots",
      "query": {"date": "{date}", "service_id": "{service_id}"},
      "result_path": "data.slots",
      "time_field": "time"
    },
    "booking": {
      "method": "POST",
      "path": "/bookings",
      "body": {
        "service_id": "{service_id}",
        "start": "{date}T{time}:00",
        "client_name": "{name}",
        "client_phone": "{phone}",
        "comment": "{comment}"
      },
      "id_path": "data.id"
    }
  }
}
