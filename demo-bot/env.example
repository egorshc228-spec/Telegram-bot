# Токен от @BotFather (лучше завести ОТДЕЛЬНОГО бота для демо)
TELEGRAM_BOT_TOKEN=

# Ключ с console.anthropic.com. Без него работают только кнопки
ANTHROPIC_API_KEY=

# Ваш Telegram ID (@userinfobot): сюда приходят заявки демо и «Хочу такого бота»
OWNER_ID=

# Модель: Haiku дешевле всех, для демо хватает
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Лимиты ИИ-сообщений: на человека в сутки и всего в сутки
USER_DAILY_LIMIT=15
GLOBAL_DAILY_LIMIT=300

# Подключение CRM (необязательно). Настройки по компаниям в JSON: см. booking.example.json.
# Либо файл booking.json в корне репозитория, либо весь JSON одной строкой в этой переменной.
# Ключи в JSON не пишите: ссылайтесь на переменные, например "env:ALTEGIO_PARTNER_TOKEN"
# BOOKING_CONFIG=
# ALTEGIO_PARTNER_TOKEN=

# Режим: 1 = демо (переключение компаний, демо-команды), 0 = рабочий режим для клиента
DEMO_MODE=1
# Компания по умолчанию: salon, auto, shop, dental
DEFAULT_NICHE=salon
# Скидка в личном кабинете: каждый N-й визит (0 = выключить) и её размер в процентах
LOYALTY_EVERY=5
LOYALTY_DISCOUNT=10

# Язык по умолчанию (ru, uk, en), пока клиент не выбрал свой
DEFAULT_LANG=ru
# Напоминания клиентам за сутки и за 2 часа до визита (0 = выключить)
REMINDERS=1
REMINDER_CHECK_SECONDS=300

# ---- Воронка ADrenaline (демо с сайта → запись на звонок). Работает только при DEMO_MODE=1 ----
FUNNEL=1
FUNNEL_LANG=uk
# Telegram ID Даниила: сюда приходят записи на звонок и «хочу такого бота» (по умолчанию OWNER_ID)
# Куда приходят записи на звонок: Telegram ID человека или ID группы «Заявки» (отрицательное число, например -1001234567890).
# В группе кнопки карточек может нажимать любой участник, ответ посетителю — ответом на сообщение бота.
SALES_CHAT_ID=1080369588
# Кому ещё можно жать кнопки и /funnel в личке с ботом (Telegram ID через запятую)
SALES_STAFF_IDS=
SALES_TG=conversion_wizard
SITE_URL=https://adrenalinegrowth.com
# Окна для звонков: дни (1 = пн), часы по Киеву, шаг в минутах, дней вперёд, минимум часов до звонка
SALES_DAYS=1,2,3,4,5
SALES_HOURS=10:00-19:00
SALES_SLOT_MIN=30
SALES_DAYS_AHEAD=7
SALES_MIN_LEAD_HOURS=2
# Фоллоу-апы тем, кто не записался: задержки от последней активности, окно отправки (часы по Киеву)
FOLLOWUPS=1
FOLLOWUP_DELAYS=30m,1d,3d,7d
FOLLOWUP_WINDOW=10-20
USD_UAH=41.5
# GA4 Measurement Protocol (необязательно): Admin → Data streams → поток сайта → Measurement Protocol API secrets
# ID потока уже указан в app/config.py. Секрет «demo-bot» задаётся только в Railway Variables, в git его не кладём
# GA4_MEASUREMENT_ID=G-SB7Y07ZZB7
GA4_API_SECRET=
